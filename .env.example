# Single-bot setup without a config file (same variables as v1).
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Socket Mode (default): an app-level token with connections:write
SLACK_APP_TOKEN=xapp-your-app-token
# HTTP mode instead: leave SLACK_APP_TOKEN out and set the signing secret
# SLACK_SIGNING_SECRET=your-signing-secret
# PUBLIC_URL=https://bots.example.com     # used by --print-manifest for request URLs
# HTTP_BIND=0.0.0.0:8080

API_KEY=your-docsgpt-agent-api-key
# API_KEY_SUPPORT=another-agent-key       # extra agents: "#support question"
# API_KEY_SALES=another-agent-key
# API_BASE=https://gptcloud.arc53.com     # self-hosted DocsGPT URL

# Storage: sqlite (default) or memory. MongoDB is no longer supported.
# SQLITE_PATH=data/docsgpt-slack.db
# STORAGE_TYPE=memory

# Behaviour
# CHANNELS=thread                         # thread | mention | off
# STREAMING=true
# AGENT_VIEW=true
# REACTIONS=true
# FILES=true
# MAX_FILE_MB=20
# ALLOWED_CHANNELS=C0123,C0456
# AGENT_DESCRIPTION=Answers questions about our product docs.

# Logging
# RUST_LOG=info
# LOG_FORMAT=json
